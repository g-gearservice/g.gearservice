---
import Wordmark from './Wordmark.astro';
import { footer } from '../data/content';
---
<footer data-section="footer">
  <div class="wrap">
    <div class="row">
      <span class="copy">© 2026 <span class="brand"><Wordmark /></span></span>
      <nav aria-label="Footer">
        {footer.nav.map((n) => n.href ? <a href={n.href}>{n.label}</a> : <span class="ph">{n.label}</span>)}
      </nav>
    </div>
  </div>
  <!-- the whole mark, half-cropped by the page bottom; its arc tips stand on the row's top border.
       Arcs as two groups so overscrolling past the page end can lift the bottom one (motion.ts → --lift) -->
  <div class="crop">
    <svg viewBox="103 369 875 447" class="end" aria-hidden="true" data-mark data-lit="all" data-reveal="rise" data-footer-mark>
      <g class="mk" style="stroke:var(--mark)"><use href="#mark-top" /></g>
      <g class="mk arc-bot" style="stroke:var(--mark)"><use href="#mark-bot" /></g>
    </svg>
  </div>
</footer>
<style>
  /* row and mark share one cell: the mark's top edge (the arc tips) is the row's top border, the row sits over the mark */
  footer { display: grid; border-top: 0; overflow: hidden; font-family: var(--font-label); font-size: 13px; color: var(--soft); }
  .wrap, .crop { grid-area: 1 / 1; align-self: start; }
  .wrap { position: relative; z-index: 1; width: 100%; }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 24px; padding-top: 12px; border-top: 1px solid var(--line); }
  .copy { padding-block: 12px; }
  .brand { color: var(--fg); font-weight: 500; letter-spacing: -0.03em; }
  nav { display: flex; flex-wrap: wrap; gap: 0 22px; }
  nav a, .ph { color: var(--soft); text-decoration: none; padding-block: 12px; }
  .crop { overflow: hidden; }
  .end { display: block; width: 96vw; height: auto; margin: 0 auto -22vw; }
  /* rubber band: rises up to 36 units (of 447) while pushed, springs back when let go */
  .arc-bot { transform: translateY(calc(var(--lift, 0) * -36px)); transition: transform 700ms var(--ease-out); }
  .end[data-pulling] .arc-bot { transition-duration: 120ms; }
</style>
