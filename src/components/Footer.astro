---
import Wordmark from './Wordmark.astro';
import { footer } from '../data/content';
import { wordmarkPaths } from '../data/marks';
// the wordmark as a mask image, for red-black's .thr-img
const wordmarkSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='103 227 875 142'>${wordmarkPaths.map((d) => `<path d='${d}'/>`).join('')}</svg>`;
---
<footer data-section="footer">
  <div class="wrap">
    <div class="row">
      <span class="copy"><span class="thr">© 2026</span> <span class="brand thr-img" style={`--shape:url("data:image/svg+xml,${encodeURIComponent(wordmarkSvg)}")`}><Wordmark /></span></span>
      <nav aria-label="Footer">
        {footer.nav.map((n) => n.href ? <a class="thr" href={n.href}>{n.label}</a> : <span class="ph thr">{n.label}</span>)}
      </nav>
    </div>
  </div>
  <!-- the whole mark, half-cropped by the page bottom; its arc tips stand on the row's top border.
       Arcs as two stacked SVGs so reaching the page end can lift the bottom one (motion.ts → data-up) on its own
       compositor layer - a transform on a <g> inside one SVG repainted the whole mark (and the blend over it) every frame -->
  <div class="crop">
    <div class="end" aria-hidden="true" data-reveal="rise" data-footer-mark>
      <svg viewBox="103 369 875 447"><g class="mk" style="stroke:var(--mark)"><use href="#mark-top" /></g></svg>
      <!-- the bottom arc is the Grok bot peeking up: its eyes sit in the hollow under the crown, drawn by bloub/eyes.js (motion.ts) -->
      <svg viewBox="103 369 875 447" class="arc-bot">
        <g class="mk" style="stroke:var(--mark)"><use href="#mark-bot" /></g>
        <g transform="translate(540 450) scale(1 -1)" style="fill:var(--mark)" data-bot-eyes /> <!-- flipped upside down; pivot moved so the eyes stay put -->
      </svg>
    </div>
  </div>
</footer>
<style>
  /* row and mark share one cell: the mark's top edge (the arc tips) is the row's top border, the row sits over the mark */
  footer { display: grid; border-top: 0; overflow: hidden; font-family: var(--font-label); font-size: 13px; color: var(--soft); }
  .wrap, .crop { grid-area: 1 / 1; align-self: start; }
  .wrap { position: relative; z-index: 1; width: 100%; }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 24px; padding-top: 12px; }
  /* row content in the reverse colour, like the header ghost: --rev difference-blended against the mark behind
     (the blend sits on .wrap: its z-index makes it the stacking context, so a blend on .row would see nothing) */
  .wrap { --rev: #fff; mix-blend-mode: difference; }
  :global([data-colorway=red-black]) .wrap { --rev: #000; mix-blend-mode: normal; } /* paints through .thr (global.css); #000 = its fallback */
  :global([data-colorway=red-mist]) .wrap { --rev: var(--fg); mix-blend-mode: normal; }
  .row { --fg: var(--rev); --soft: var(--rev); color: var(--rev); }
  .copy { padding-block: 12px; }
  .brand { display: inline-block; vertical-align: middle; line-height: 0; color: var(--fg); font-weight: 500; letter-spacing: -0.03em; } /* a box the size of the artwork, so the red-black mask fits it */
  nav { display: flex; flex-wrap: wrap; gap: 0 22px; }
  nav a, .ph { color: var(--soft); text-decoration: none; padding-block: 12px; }
  .crop { overflow: hidden; }
  .end { display: grid; width: 96vw; margin: 0 auto -22vw; }
  .end > svg { grid-area: 1 / 1; display: block; width: 100%; height: auto; }
  /* at the page end the bottom arc rises 36 units (of 447 = 8.05% of the box) */
  .end > svg { transition: transform 350ms var(--ease-out); will-change: transform; }
  .end[data-up] .arc-bot { transform: translateY(-8.05%); }
  /* at the end the top arc also drops until its tips touch the © line (motion.ts → --drop) */
  .end[data-up] > svg:first-child { transform: translateY(var(--drop, 0px)); }
</style>
