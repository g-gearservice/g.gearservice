---
// Pinned hero: a scroll-scrubbed intro (the wordmark lifts the lockup to the centre, rises off alone, the symbol zooms),
// then scenes (motion.ts sets data-scene from scroll; motion.css transitions between them):
//   0 lockup · 1 arcs part, statement in the lens · 2 the statement's body takes its place · 3 arcs rejoin, "the mark is the team."
//   4/5/6 top arc, lens, bottom arc lit
// The two halves (wordmark + top arc / bottom arc) carry --p (the logo --a / --z); one Mark per part on top holds its highlight
// (a whole <svg> each, so its fade is a composited opacity, not a repaint of the zoomed, masked mark).
import textSvg from '../../SVG/black-text.svg?raw';
// wordmark: SVG/black-text.svg verbatim, sized to the top arc's outer edges (x 103.09 → 977.62: the strands ± half the 24
// stroke) with the g descender standing on the arc's tips (y 368.96). Text box in the asset: x 12.72 → 887.28, bottom 145.79,
// so scale = 874.53 / 874.56 ≈ 1, translate = (103.09 - 12.72, 368.96 - 145.79)
const textPaths = [...textSvg.matchAll(/ d="([^"]+)"/g)].map((m) => m[1]);
import Mark from './Mark.astro';
import { statement, anatomy } from '../data/content';
---
<section data-section="hero" class="hero">
  <span id="anatomy" class="anchor" aria-hidden="true"></span>
  <div class="stage" data-hero-stage data-scene="0">
    <div class="wrap">
      <h1 class="sr">g.gearservice</h1>
      <div class="logo" data-hero-logo>
        <svg viewBox="103 227 875 589" class="half half--top" aria-hidden="true" data-mark data-lit="all">
          <g data-wordmark style="fill:var(--mark)"><g transform="translate(90.37 223.17)">{textPaths.map((d, i) => <path d={d} data-letter style={`--i:${i}`} />)}</g></g>
          <g class="mk" data-mark-lit style="stroke:var(--mark)"><use href="#mark-top" /></g>
        </svg>
        <svg viewBox="103 227 875 589" class="half half--bot" aria-hidden="true" data-mark data-lit="all">
          <g class="mk" data-mark-lit style="stroke:var(--mark)"><use href="#mark-bot" /></g>
        </svg>
        {(["T", "C", "B"] as const).map((p) => <Mark lit={p} viewBox="103 227 875 589" class="half part" />)}
      </div>
      <div class="lens" data-hero-lens>
        <h2 class="lens-line" data-copy="1">{statement.title[0]}<br />{statement.title[1]}</h2>
        <p class="lens-body" data-copy="2">{statement.body}</p>
        <div class="copy" data-copy="3">
          <p class="k">{anatomy.eyebrow}</p>
          <h2 class="n">{anatomy.title}</h2>
          <p class="b">{anatomy.body}</p>
        </div>
        {anatomy.labels.map((l, i) => (
          <div class="copy" data-copy={i + 4}><p class="k">{l.kicker}</p><h3 class="n">{l.name}</h3></div>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .hero { position: relative; }
  /* nav "anatomy" lands on scene 2 (motion.css places it; without JS it is the top of the hero) */
  .anchor { position: absolute; top: 0; }
  /* static (no JS): the parted state, with room above and below for the moved halves (50% of the lockup height) */
  /* the captions sit in .lens, a twin of .logo's box outside its zoom: text under a scale is drawn as a stretched bitmap and
     breaks up, so instead their sizes are multiplied by the zoom (--k, motion.css) and they render at their real size */
  .wrap { display: grid; }
  .logo, .lens { grid-area: 1 / 1; --k: 1; }
  .lens { pointer-events: none; }
  .logo, .lens { position: relative; aspect-ratio: 875 / 589; margin: calc(50% * 589 / 875) auto calc(50% * 589 / 875 + 48px); container-type: inline-size; }
  /* :global — the .part overlays come from <Mark>, whose svg carries no scope attribute */
  .logo :global(.half) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  /* centred in the lens: y 591.5 of the 227-816 lockup */
  .lens-line {
    position: absolute; left: 50%; width: calc(100% * var(--k)); top: 61.9%; translate: -50% -50%;
    font-family: var(--font-display); font-size: calc(10cqw * var(--k)); line-height: 0.95; letter-spacing: -0.045em; font-weight: 500;
    text-align: center; white-space: nowrap;
  }
  /* the statement's body: next scene, in the headline's place (the parted arcs leave the middle open) */
  .lens-body {
    position: absolute; left: 50%; top: 61.9%; translate: -50% -50%; width: calc(56% * var(--k)); margin: 0;
    text-align: center; text-wrap: balance; font-size: calc(max(2.6cqw, 14px) * var(--k)); line-height: 1.5; letter-spacing: -0.01em;
  }
  /* no JS: no scenes, so it sits under the headline inside the parted bottom arc's dome (y 81% of the box, moved down 50%) */
  :global(html:not(.js)) .lens-body { top: 131%; width: 62%; font-size: max(2.1cqw, 12px); color: var(--soft); }
  /* anatomy captions: inside the closed lens (x 250-830, y 442-741), one per scene */
  .copy {
    position: absolute; left: 50%; top: 61.9%; translate: -50% -50%; width: calc(44% * var(--k));
    display: flex; flex-direction: column; align-items: center; gap: calc(0.9cqw * var(--k)); text-align: center;
  }
  .copy > * { margin: 0; }
  .copy .k { font-family: var(--font-label); font-size: calc(max(1.1cqw, 11px) * var(--k)); color: var(--soft); }
  .copy .n { font-family: var(--font-display); font-size: calc(5.2cqw * var(--k)); line-height: 1; letter-spacing: -0.045em; font-weight: 500; white-space: nowrap; }
  .copy .b { font-size: calc(max(1.25cqw, 12px) * var(--k)); line-height: 1.5; color: var(--soft); text-wrap: balance; }
  /* phones: the closed lens is too small for the sentence, so it drops under the mark (lens centre → mark foot = 25.6cqw) */
  @container (max-width: 600px) {
    .copy .n { font-size: calc(max(5.2cqw, 20px) * var(--k)); }
    .copy .b { position: absolute; left: 50%; top: calc(50% + (25.6cqw + 24px) * var(--k)); translate: -50% 0; width: calc(min(100cqw, 320px) * var(--k)); }
  }
  /* no JS: scenes never run, so the anatomy captions stay out of the static (parted) lockup */
  :global(html:not(.js)) .copy, :global(html:not(.js) .part) { display: none; }
</style>
