---
// Pinned hero, played as scenes (motion.ts sets data-scene from scroll; motion.css transitions between them):
//   0 lockup · 1 arcs part, statement in the lens · 2 arcs rejoin, "the mark is the team." · 3/4/5 top arc, lens, bottom arc lit
// The two halves (wordmark + top arc / bottom arc) carry --a / --p; the split Mark on top holds the per-part highlights.
import textSvg from '../../SVG/black-text.svg?raw';
// wordmark: SVG/black-text.svg verbatim, scaled to sit on the symbol: the g descender touches the top arc (y 368.96)
const textPaths = [...textSvg.matchAll(/ d="([^"]+)"/g)].map((m) => m[1]);
import Mark from './Mark.astro';
import { statement, anatomy } from '../data/content';
---
<section data-section="hero" class="hero">
  <span id="anatomy" class="anchor" aria-hidden="true"></span>
  <div class="stage" data-hero-stage data-scene="0">
    <div class="wrap">
      <h1 class="sr">g.gearservice</h1>
      <div class="logo" data-hero-logo>
        <svg viewBox="103 227 875 589" class="half half--top" aria-hidden="true" data-mark data-lit="all">
          <g data-wordmark style="fill:var(--mark)"><g transform="translate(90.42 228.27) scale(0.965)">{textPaths.map((d, i) => <path d={d} data-letter style={`--i:${i}`} />)}</g></g>
          <g class="mk" data-mark-lit style="stroke:var(--mark)"><use href="#mark-top" /></g>
        </svg>
        <svg viewBox="103 227 875 589" class="half half--bot" aria-hidden="true" data-mark data-lit="all">
          <g class="mk" data-mark-lit style="stroke:var(--mark)"><use href="#mark-bot" /></g>
        </svg>
        <Mark lit="none" split viewBox="103 227 875 589" class="half parts" />
        <div class="half half--bot arch-copy"><p data-lens-line>{statement.body}</p></div>
        <h2 class="lens-line" data-lens-line>{statement.title[0]}<br />{statement.title[1]}</h2>
        <div class="copy" data-copy="2">
          <p class="k">{anatomy.eyebrow}</p>
          <h2 class="n">{anatomy.title}</h2>
          <p class="b">{anatomy.body}</p>
        </div>
        {anatomy.labels.map((l, i) => (
          <div class="copy" data-copy={i + 3}><p class="k">{l.kicker}</p><h3 class="n">{l.name}</h3></div>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .hero { position: relative; }
  /* nav "anatomy" lands on scene 2 (motion.css places it; without JS it is the top of the hero) */
  .anchor { position: absolute; top: 0; }
  /* static (no JS): the parted state, with room above and below for the moved halves (50% of the lockup height) */
  .logo { position: relative; aspect-ratio: 875 / 589; margin: calc(50% * 589 / 875) auto calc(50% * 589 / 875 + 48px); container-type: inline-size; }
  .half { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  /* centred in the lens: y 591.5 of the 227-816 lockup */
  .lens-line {
    position: absolute; inset-inline: 0; top: 61.9%; translate: 0 -50%;
    font-family: var(--font-display); font-size: 10cqw; line-height: 0.95; letter-spacing: -0.045em; font-weight: 500;
    text-align: center; white-space: nowrap;
  }
  /* body copy rides the bottom arc, inside its dome: y 600-800 of the lockup, where the dome is ~630 units wide */
  .arch-copy p {
    position: absolute; left: 50%; top: 81%; translate: -50% -50%; width: 62%; margin: 0;
    text-align: center; text-wrap: balance; font-size: max(2.1cqw, 12px); line-height: 1.6; color: var(--soft);
  }
  /* anatomy captions: inside the closed lens (x 250-830, y 442-741), one per scene */
  .copy {
    position: absolute; left: 50%; top: 61.9%; translate: -50% -50%; width: 44%;
    display: flex; flex-direction: column; align-items: center; gap: 0.9cqw; text-align: center;
  }
  .copy > * { margin: 0; }
  .copy .k { font-family: var(--font-label); font-size: max(1.1cqw, 11px); color: var(--soft); }
  .copy .n { font-family: var(--font-display); font-size: 5.2cqw; line-height: 1; letter-spacing: -0.045em; font-weight: 500; white-space: nowrap; }
  .copy .b { font-size: max(1.25cqw, 12px); line-height: 1.5; color: var(--soft); text-wrap: balance; }
  /* phones: the closed lens is too small for the sentence, so it drops under the mark (lens centre → mark foot = 25.6cqw) */
  @container (max-width: 600px) {
    .copy .n { font-size: max(5.2cqw, 20px); }
    .copy .b { position: absolute; left: 50%; top: calc(50% + 25.6cqw + 24px); translate: -50% 0; width: min(100cqw, 320px); }
  }
  /* no JS: scenes never run, so the anatomy captions stay out of the static (parted) lockup */
  :global(html:not(.js)) .copy, :global(html:not(.js)) .parts { display: none; }
</style>
