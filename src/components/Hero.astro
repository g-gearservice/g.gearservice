---
import { wordmarkPaths } from '../data/marks';
---
<section data-section="hero">
  <div class="wrap">
    <h1 class="sr">g.gearservice</h1>
    <div class="logo-row">
      <div class="logo" data-hero-logo>
        <svg viewBox="103 227 875 589" aria-hidden="true" data-mark data-lit="all">
          <g data-wordmark style="fill:var(--mark)">{wordmarkPaths.map((d, i) => <path d={d} data-letter style={`--i:${i}`} />)}</g>
          <g class="mk" data-mark-lit data-part="all" style="stroke:var(--mark)"><use href="#mark-paths" /></g>
        </svg>
      </div>
    </div>
  </div>
</section>
<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .logo-row { display: flex; justify-content: center; padding-bottom: 66px; } /* = the prototype's empty tagline line (8 + 34 + 24) */
  .logo { width: min(100%, 1240px, calc((100vh - 145px) * 1.487)); width: min(100%, 1240px, calc((100svh - 145px) * 1.487)); }
  .logo svg { width: 100%; height: auto; display: block; }
</style>
