---
// Lockup split in two layers: wordmark + top arc / bottom arc. On scroll they part (motion.css, --p 0→1)
// and the statement headline appears in the lens between them; the body copy sits inside the bottom arc.
import textSvg from '../../SVG/black-text.svg?raw';
// wordmark: SVG/black-text.svg verbatim, scaled to sit on the symbol: the g descender touches the top arc (y 368.96)
const textPaths = [...textSvg.matchAll(/ d="([^"]+)"/g)].map((m) => m[1]);
import { statement } from '../data/content';
---
<section data-section="hero" class="hero">
  <div class="stage" data-hero-stage>
    <div class="wrap">
      <h1 class="sr">g.gearservice</h1>
      <div class="logo" data-hero-logo>
        <svg viewBox="103 227 875 589" class="half half--top" aria-hidden="true" data-mark data-lit="all">
          <g data-wordmark style="fill:var(--mark)"><g transform="translate(90.42 228.27) scale(0.965)">{textPaths.map((d, i) => <path d={d} data-letter style={`--i:${i}`} />)}</g></g>
          <g class="mk" data-mark-lit style="stroke:var(--mark)"><use href="#mark-top" /></g>
        </svg>
        <svg viewBox="103 227 875 589" class="half half--bot" aria-hidden="true" data-mark data-lit="all">
          <g class="mk" data-mark-lit style="stroke:var(--mark)"><use href="#mark-bot" /></g>
        </svg>
        <div class="half half--bot arch-copy"><p data-lens-line>{statement.body}</p></div>
        <h2 class="lens-line" data-lens-line>{statement.title[0]}<br />{statement.title[1]}</h2>
      </div>
    </div>
  </div>
</section>
<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  /* static (no JS / reduced motion): the parted state, with room above and below for the moved halves (50% of the lockup height) */
  .logo { position: relative; aspect-ratio: 875 / 589; margin: calc(50% * 589 / 875) auto calc(50% * 589 / 875 + 48px); container-type: inline-size; }
  .half { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  /* centred in the lens: y 591.5 of the 227-816 lockup */
  .lens-line {
    position: absolute; inset-inline: 0; top: 61.9%; translate: 0 -50%;
    font-family: var(--font-display); font-size: 10cqw; line-height: 0.95; letter-spacing: -0.045em; font-weight: 500;
    text-align: center; white-space: nowrap;
  }
  /* body copy rides the bottom arc, inside its dome: y 600-800 of the lockup, where the dome is ~630 units wide */
  .arch-copy p {
    position: absolute; left: 50%; top: 81%; translate: -50% -50%; width: 62%; margin: 0;
    text-align: center; text-wrap: balance; font-size: max(2.1cqw, 12px); line-height: 1.6; color: var(--soft);
  }
</style>
