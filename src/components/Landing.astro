---
// One page, six colorways: sections read CSS vars only.
import Header from './Header.astro';
import Hero from './Hero.astro';
import Statement from './Statement.astro';
import Anatomy from './Anatomy.astro';
import Team from './Team.astro';
import Process from './Process.astro';
import Work from './Work.astro';
import Log from './Log.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
---
<div class="page" id="top">
  <Header />
  <main>
    <Hero />
    <Statement />
    <Anatomy />
    <Team />
    <Process />
    <Work />
    <Log />
    <Contact />
  </main>
  <Footer />
</div>
