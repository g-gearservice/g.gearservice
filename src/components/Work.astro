---
import Eyebrow from './Eyebrow.astro';
import Status from './Status.astro';
import { work } from '../data/content';
---
<section id="work" data-section="work" class="work">
  <div class="wrap in">
    <div class="head">
      <Eyebrow>{work.eyebrow}</Eyebrow>
      <h2 class="h2" data-reveal="display">{work.title}</h2>
    </div>
    <ul class="list" role="list">
      {work.items.map((w) => (
        <li data-reveal-item data-embed={w.embed ? w.href : undefined}>
          <div class="title">
            {w.href
              ? <a href={w.href} rel="noopener">{w.name} <span aria-hidden="true">↗</span></a>
              : <span class="plain">{w.name}</span>}
          </div>
          <div class="meta">
            <span class="desc">{w.desc}</span>
            <div class="statuses">{w.statuses.map((s) => w.embed && s.label === 'live'
              ? <button type="button" class="live" aria-expanded="false" aria-controls={`embed-${w.name}`} data-live><span class="dot" aria-hidden="true"></span>{s.label}</button>
              : <Status kind={s.kind} label={s.label} />)}</div>
          </div>
          {w.embed && (
            <div class="embed" id={`embed-${w.name}`} inert>
              <div class="embed__clip">
                <div class="embed__frame">
                  <div class="embed__screen">
                    <iframe title={`${w.name}, live`} data-src={w.href} referrerpolicy="no-referrer" loading="lazy"></iframe>
                    <button type="button" class="ctl ctl--play" data-play><svg viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0 10 6 0 12Z" /></svg>play</button>
                    <button type="button" class="ctl ctl--pause" data-pause><svg viewBox="0 0 10 12" aria-hidden="true"><path d="M0 0h3.5v12H0zM6.5 0H10v12H6.5z" /></svg>pause</button>
                  </div>
                  <a class="embed__out" href={w.href} rel="noopener">open in a new tab ↗</a>
                </div>
              </div>
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
<script>
  // the live button opens the embed under its row: the grid row grows (pushing the rows below, and their border, down)
  // while the frame rises into place. The site loads on first open and waits behind a blur; play lifts the blur and
  // hands it the pointer, pause (or closing the row) puts it back under. Clicking into the playing site locks the
  // page scroll (motion.ts) until focus comes back to the page.
  document.querySelectorAll<HTMLElement>('[data-embed]').forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('[data-live]');
    const box = li.querySelector<HTMLElement>('.embed');
    const frame = li.querySelector<HTMLIFrameElement>('iframe');
    const screen = li.querySelector<HTMLElement>('.embed__screen');
    if (!btn || !box || !frame || !screen) return;
    frame.inert = true;
    const lock = (on: boolean) => dispatchEvent(new CustomEvent('scrolllock', { detail: on }));
    // a click into a cross-origin frame only shows as the page losing focus to it
    addEventListener('blur', () => setTimeout(() => { if (document.activeElement === frame && !frame.inert) lock(true); }));
    addEventListener('focus', () => lock(false));
    const play = (on: boolean, focus = true) => {
      frame.inert = !on;
      if (!on) lock(false);
      screen.classList.toggle('is-playing', on);
      if (focus) li.querySelector<HTMLButtonElement>(on ? '[data-pause]' : '[data-play]')!.focus({ preventScroll: true });
    };
    li.querySelector('[data-play]')!.addEventListener('click', () => play(true));
    li.querySelector('[data-pause]')!.addEventListener('click', () => play(false));
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      if (open && !frame.src) frame.src = frame.dataset.src!;
      if (!open) play(false, false);
      btn.setAttribute('aria-expanded', String(open));
      box.inert = !open;
      li.classList.toggle('is-open', open);
    });
  });
</script>
<style>
  .in { padding-block: clamp(56px, 6vw, 96px); display: flex; flex-direction: column; gap: clamp(36px, 4.4vw, 64px); }
  .head { display: flex; flex-direction: column; gap: 20px; }
  .list { border-bottom: 1px solid var(--line); }
  li { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 48px; padding-block: clamp(24px, 3vw, 40px); border-top: 1px solid var(--fg); }
  .title { flex: 2 1 440px; }
  a { display: inline-block; color: var(--fg); font-family: var(--font-display); /* same size as .plain, the unlinked names below */ font-size: clamp(30px, 4.4vw, 64px); line-height: 1.05; letter-spacing: -0.045em; font-weight: 500; text-decoration: underline; text-decoration-thickness: 0.04em; text-underline-offset: 0.12em; overflow-wrap: break-word; transition: text-underline-offset 250ms var(--ease-out); }
  .plain { display: inline-block; font-family: var(--font-display); font-size: clamp(30px, 4.4vw, 64px); line-height: 1.05; letter-spacing: -0.045em; font-weight: 500; overflow-wrap: anywhere; }
  .meta { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .desc { font-size: 17px; line-height: 1.6; }
  /* live: the nav's contact pill, small */
  .live { display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border: 0; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-family: var(--font-label); font-size: 14px; font-weight: 500; cursor: pointer; transition: opacity 150ms ease, transform 160ms var(--ease-out); }
  .live:hover { opacity: .85; }
  .live:active { transform: scale(.97); transition-duration: 150ms, 100ms; }
  .live .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--on-accent); }
  .embed { flex: 0 0 100%; display: grid; grid-template-rows: 0fr; transition: grid-template-rows 600ms var(--ease-out); }
  .is-open .embed { grid-template-rows: 1fr; }
  .embed__clip { min-height: 0; overflow: hidden; }
  .embed__frame { display: flex; flex-direction: column; gap: 10px; padding-top: clamp(8px, 1.5vw, 20px); opacity: 0; transform: translateY(48px); transition: opacity 400ms var(--ease-out), transform 600ms var(--ease-out); }
  .is-open .embed__frame { opacity: 1; transform: none; transition-delay: 80ms; }
  iframe { display: block; width: 100%; height: clamp(420px, 70svh, 760px); border: 1px solid var(--line); border-radius: 20px; background: var(--panel); }
  .embed__screen { position: relative; overflow: hidden; border-radius: 20px; }
  /* idle: the loaded site sits blurred under the play button (scaled so the blur's soft edge stays outside the clip) */
  .embed__screen iframe { transition: filter 400ms var(--ease-out), scale 400ms var(--ease-out); }
  .embed__screen:not(.is-playing) iframe { filter: blur(14px); scale: 1.06; pointer-events: none; }
  /* play / pause: the live pill, bigger; play sits centred on the idle panel, pause in the corner while it runs */
  .ctl { position: absolute; display: inline-flex; align-items: center; gap: 10px; padding: 12px 24px; border: 0; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-family: var(--font-label); font-size: 17px; font-weight: 500; cursor: pointer; transition: opacity 150ms ease, transform 160ms var(--ease-out); }
  .ctl:hover { opacity: .85; }
  .ctl:active { transform: scale(.97); transition-duration: 150ms, 100ms; }
  .ctl svg { width: 10px; height: 12px; fill: currentColor; }
  .ctl--play { top: 50%; left: 50%; translate: -50% -50%; }
  .ctl--pause { top: 14px; right: 14px; padding: 8px 16px; font-size: 14px; }
  .embed__screen:not(.is-playing) .ctl--pause, .is-playing .ctl--play { display: none; }
  .embed__out { align-self: flex-end; font-family: var(--font-label); font-size: 13px; line-height: 1.4; letter-spacing: 0; font-weight: 400; text-decoration: none; color: var(--soft); }
  /* hover drops the underline .12em → .2em (motion.css); it glides both ways instead of jumping */
  @media (prefers-reduced-motion: reduce) { a, .embed, .embed__frame { transition: none; } }
  .statuses { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
</style>
