---
import Glyph from './Glyph.astro';
import { nav } from '../data/content';
// the home glyph as a mask image, for red-black's .thr-img
const glyphSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 22 22' fill='none' stroke='#000' stroke-width='2.4'><path d='M3 2A10 10 0 0 1 3 20'/><path d='M19 2A10 10 0 0 0 19 20'/></svg>`;
---
<div class="blur top" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
<div class="blur bot" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
<div class="blur side lft" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
<div class="blur side rgt" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
{[false, true].map((ghost) => (
  /* ghost: an inert copy that paints only the text links, difference-blended against the page.
     The real header is sticky (its own stacking context), so a blend inside it can't see the page.
     red-black thresholds instead (.thr, global.css) */
  <header class:list={{ ghost }} aria-hidden={ghost ? 'true' : undefined} inert={ghost}>
    <div class="wrap bar" data-hero-chrome>
      <a class:list={['home', { 'thr-img': ghost }]} href="#top" aria-label="g.gearservice, back to top" style={ghost ? `--shape:url("data:image/svg+xml,${encodeURIComponent(glyphSvg)}")` : undefined}><Glyph size={26} /></a>
      <nav aria-label={ghost ? undefined : 'Main'}>
        {nav.map((n) => <a class:list={{ thr: ghost }} href={n.href}>{n.label}</a>)}
        <a class="cta" href="#contact">contact</a>
      </nav>
    </div>
  </header>
))}
<style>
  /* sticky at top:0 = fixed for a first-child header, but keeps its flow height (Hero sizes against it) */
  header { position: sticky; top: 0; z-index: 10; }
  /* hidden while scrolling down (motion.ts); the blur stays put. Focus brings it back. */
  :global(.nav-up) header:not(:focus-within) { translate: 0 -100%; }
  @media (prefers-reduced-motion: no-preference) { header { transition: translate var(--nav-dur, .35s) var(--ease-out); } }
  .bar { position: relative; }
  /* Screen-edge blur, pinned to the viewport outside the header so it stays when the header slides away.
     Six layers, each blurred at one strength and masked to a band of the fade (OuterVale, "Blobby Navbar Blur").
     Top morphs with the header: shown = regiontype.com's home band (layers fade in over 30% bands, blur exactly 0
     at the inner edge, x .55, over 120px, + 34% --bg scrim), hidden (html.nav-up) = our
     original blur (1-32px over the bar's 72px + 32px). Each layer's band edges --m0/--m1 (@property, global.css) and blur
     radius transition, so the blurred range slides between the two shapes instead of two layers cross-dissolving. */
  .blur { position: fixed; top: 0; left: 0; right: 0; height: 120px; z-index: 9; pointer-events: none; display: grid; }
  .blur i, .blur::after { grid-area: 1 / 1; }
  .blur::after { content: ""; }
  /* bottom: our original blur, mirrored (strongest at the screen edge, no scrim) — the top's header-hidden shape */
  .bot { top: auto; bottom: 0; height: 104px; --dir: to top; }
  /* left / right: the same fade, turned to face each side edge */
  .side { bottom: 0; height: auto; width: 72px; } /* ponytail: width picked by eye, tune here */
  .lft { right: auto; --dir: to right; }
  .rgt { left: auto; --dir: to left; }
  :is(.bot, .side) i:nth-child(1) { backdrop-filter: blur(1px);  mask: linear-gradient(var(--dir), #000 40%, transparent 60%); }
  :is(.bot, .side) i:nth-child(2) { backdrop-filter: blur(2px);  mask: linear-gradient(var(--dir), #000 30%, transparent 50%); }
  :is(.bot, .side) i:nth-child(3) { backdrop-filter: blur(4px);  mask: linear-gradient(var(--dir), #000 20%, transparent 40%); }
  :is(.bot, .side) i:nth-child(4) { backdrop-filter: blur(8px);  mask: linear-gradient(var(--dir), #000 10%, transparent 30%); }
  :is(.bot, .side) i:nth-child(5) { backdrop-filter: blur(16px); mask: linear-gradient(var(--dir), #000 0%, transparent 20%); }
  :is(.bot, .side) i:nth-child(6) { backdrop-filter: blur(32px); mask: linear-gradient(var(--dir), #000 0%, transparent 10%); }
  /* top, header shown: the regiontype band (its 0deg masks, flipped into top-down px). Opaque to --m0, clear at --m1 */
  .top i { mask: linear-gradient(#000 var(--m0), transparent var(--m1)); transition: --m0 var(--nav-dur, .35s) var(--ease-out), --m1 var(--nav-dur, .35s) var(--ease-out), backdrop-filter var(--nav-dur, .35s) var(--ease-out); }
  .top i:nth-child(1) { backdrop-filter: blur(.55px);  --m0: 102px; --m1: 120px; }
  .top i:nth-child(2) { backdrop-filter: blur(2.2px);  --m0: 84px;  --m1: 114px; }
  .top i:nth-child(3) { backdrop-filter: blur(4.4px);  --m0: 66px;  --m1: 102px; }
  .top i:nth-child(4) { backdrop-filter: blur(8.8px);  --m0: 48px;  --m1: 84px; }
  .top i:nth-child(5) { backdrop-filter: blur(13.2px); --m0: 30px;  --m1: 66px; }
  .top i:nth-child(6) { backdrop-filter: blur(17.6px); --m0: 12px;  --m1: 48px; }
  .top::after { background: linear-gradient(color-mix(in srgb, var(--bg) 34%, transparent) 60%, transparent); opacity: 1; transition: opacity var(--nav-dur, .35s) var(--ease-out); }
  /* top, header hidden: our original blur (px of the 120px box; it spanned 104px) */
  :global(.nav-up:not(:has(header:focus-within))) .top {
    i:nth-child(1) { backdrop-filter: blur(1px);  --m0: 41.6px; --m1: 62.4px; }
    i:nth-child(2) { backdrop-filter: blur(2px);  --m0: 31.2px; --m1: 52px; }
    i:nth-child(3) { backdrop-filter: blur(4px);  --m0: 20.8px; --m1: 41.6px; }
    i:nth-child(4) { backdrop-filter: blur(8px);  --m0: 10.4px; --m1: 31.2px; }
    i:nth-child(5) { backdrop-filter: blur(16px); --m0: 0px;    --m1: 20.8px; }
    i:nth-child(6) { backdrop-filter: blur(32px); --m0: 0px;    --m1: 10.4px; }
    &::after { opacity: 0; }
  }
  /* Phone Safari tab: no edge blur. iOS 26 won't draw fixed/backdrop-filter layers under the status bar or address bar
     (it paints a solid strip instead, a hard line); only document content shows there. So, like regiontype.com's
     flowing pages, nothing sits on the edges and the page scrolls straight under both bars. */
  @media (pointer: coarse) and (display-mode: browser) { .blur { display: none; } }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 16px; padding-block: 12px; }
  .home { display: flex; padding: 11px 11px 11px 0; }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0 2px; font-family: var(--font-label); font-size: 17px; }
  nav a { text-decoration: none; color: var(--fg); padding: 12px 10px; }
  /* glyph + text links: inverted against whatever is behind (drawn by the ghost; the real ones stay clickable but clear) */
  header:not(.ghost) nav a:not(.cta) { color: transparent; text-decoration-color: var(--fg); }
  header:not(.ghost) .home :global(svg) { opacity: 0; }
  :global(.nav-up:has(header:focus-within)) .ghost { translate: none; } /* follow the real header back when focused */
  /* --rev: the reverse colour the ghost paints with (white by default, difference-blended) */
  .ghost { --rev: #fff; position: fixed; top: 0; left: 0; right: 0; z-index: 11; pointer-events: none; mix-blend-mode: difference; }
  .ghost .home, .ghost nav a:not(.cta) { --fg: var(--rev); color: var(--rev); }
  /* red-black: the ghost paints through .thr / .thr-img (global.css) instead of a blend. The cta pill is the same
     threshold (black on the red, white over black; the border-radius clips it), its label stays red on top */
  :global([data-colorway=red-black]) .ghost { --rev: #000; mix-blend-mode: normal; }
  :global([data-colorway=red-black]) .ghost nav a.cta { background: var(--accent); color: var(--on-accent); }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    :global([data-colorway=red-black]) .ghost nav a.cta { background: transparent; -webkit-backdrop-filter: var(--thr); backdrop-filter: var(--thr); }
  }
  /* red-white: no difference blend can turn red ground white (white - red = cyan), so it paints plain white */
  :global([data-colorway=red-mist]) .ghost { --rev: var(--fg); mix-blend-mode: normal; }
  nav a.cta { margin-left: 8px; padding: 11px 20px; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-weight: 500; }
  /* cta, inverted too: white pill = inverse of what's behind; #000 label = the backdrop showing through.
     The real pill stays clickable but clear; its hover/press feedback is mirrored onto the ghost. */
  header:not(.ghost) nav a.cta { background: transparent; color: transparent; }
  .ghost nav a.cta { background: var(--rev); color: #000; }
  :global([data-colorway=red-mist]) .ghost nav a.cta { color: var(--on-accent); } /* not blended: red label on the white pill */
  header:has(.cta:hover) ~ .ghost .cta { opacity: .85; }
  header:has(.cta:active) ~ .ghost .cta { transform: scale(.97); }
  /* 375px: glyph + 4 links must stay on one row (full-size paddings total ~334px of 335px) */
  @media (max-width: 420px) {
    .bar { flex-wrap: nowrap; gap: 0 8px; }
    nav { flex-wrap: nowrap; gap: 0; font-size: 15px; }
    nav a { padding-inline: 6px; }
    nav a.cta { margin-left: 4px; padding-inline: 14px; }
  }
</style>
