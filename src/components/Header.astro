---
import Glyph from './Glyph.astro';
import { nav } from '../data/content';
---
<header>
  <div class="blur" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="wrap bar" data-hero-chrome>
    <a class="home" href="#top" aria-label="g.gearservice, back to top"><Glyph size={26} /></a>
    <nav aria-label="Main">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a class="cta" href="#contact">contact</a>
    </nav>
  </div>
</header>
<style>
  /* sticky at top:0 = fixed for a first-child header, but keeps its flow height (Hero sizes against it) */
  header { position: sticky; top: 0; z-index: 10; }
  .bar { position: relative; }
  /* progressive blur (OuterVale): blur doubles per layer, each masked to a band of the fade */
  .blur { position: absolute; inset: 0 0 -32px; pointer-events: none; }
  .blur i { position: absolute; inset: 0; }
  .blur i:nth-child(1) { backdrop-filter: blur(1px);  mask: linear-gradient(to bottom, #000 0%, #000 40%, transparent 60%); }
  .blur i:nth-child(2) { backdrop-filter: blur(2px);  mask: linear-gradient(to bottom, #000 0%, #000 30%, transparent 50%); }
  .blur i:nth-child(3) { backdrop-filter: blur(4px);  mask: linear-gradient(to bottom, #000 0%, #000 20%, transparent 40%); }
  .blur i:nth-child(4) { backdrop-filter: blur(8px);  mask: linear-gradient(to bottom, #000 0%, #000 10%, transparent 30%); }
  .blur i:nth-child(5) { backdrop-filter: blur(16px); mask: linear-gradient(to bottom, #000 0%, transparent 20%); }
  .blur i:nth-child(6) { backdrop-filter: blur(32px); mask: linear-gradient(to bottom, #000 0%, transparent 10%); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 16px; padding-block: 12px; }
  .home { display: flex; padding: 11px 11px 11px 0; }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0 2px; font-family: var(--font-label); font-size: 15px; }
  nav a { text-decoration: none; color: var(--fg); padding: 12px 10px; }
  nav a.cta { margin-left: 8px; padding: 11px 20px; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-weight: 500; }
  /* 375px: glyph + 4 links must stay on one row (full-size paddings total ~334px of 335px) */
  @media (max-width: 420px) {
    .bar { flex-wrap: nowrap; gap: 0 8px; }
    nav { flex-wrap: nowrap; gap: 0; }
    nav a { padding-inline: 6px; }
    nav a.cta { margin-left: 4px; padding-inline: 14px; }
  }
</style>
